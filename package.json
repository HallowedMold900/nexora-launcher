{
  "name": "nexora-launcher",
  "version": "0.4.4",
  "description": "Nexora Launcher",
  "author": "HallowedMold900",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hallowedmold900.nexora",
    "productName": "Nexora Launcher",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "build/icon.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "HallowedMold900",
        "repo": "nexora-launcher",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    }
  }
}
